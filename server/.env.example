# BattleMind Server Configuration
# Copier ce fichier en .env et remplir les valeurs

# ── Réseau ──────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Sécurité ────────────────────────────────────────────────
# En production, remplacer * par l'URL de votre app mobile
CORS_ORIGIN=*

# ── Base de données ──────────────────────────────────────────
# En local     : laisser vide (utilise ./data/battlemind.db)
# Sur Render   : /var/data/battlemind.db (avec disque persistant)
DATABASE_PATH=

# ── Logs ────────────────────────────────────────────────────
LOG_LEVEL=info
